{
  "schemaVersion": 1,
  "id": "createaddition",
  "version": "${version}",
  "name": "Create Crafts & Additions",
  "description": "Create Crafts & Additions extends Create and acts as a bridge between electric and kinetic energy from Create.\n\nUnofficial Fabric 26.1.2 port on Create Fly.",
  "authors": ["MRH0"],
  "contributors": ["AlphaMode", "Skippyall", "BobDole", "legoatoom", "gobiidaiah", "StockiesLad", "THEREDSTONEBRO", "lawliet__", "Uraxys"],
  "contact": {
    "sources": "https://github.com/mrh0/createaddition",
    "issues": "https://github.com/mrh0/createaddition/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.mrh0.createaddition.CreateAddition"],
    "client": ["com.mrh0.createaddition.CreateAdditionClient"]
  },
  "accessWidener": "createaddition.accesswidener",
  "mixins": ["createaddition.mixins.json"],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "forgeconfigapiport": ">=${forgeconfigapiport_version}",
    "create": "${create_fly_version_range}",
    "team_reborn_energy": ">=${tr_energy_version}",
    "java": ">=25"
  }
}
